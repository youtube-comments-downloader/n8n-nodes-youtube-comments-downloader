{
  "$schema": "./node_modules/release-it/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "requireCommits": true,
    "commit": true,
    "tag": true,
    "push": true,
    "commitMessage": "Release ${version}",
    "tagName": "${version}",
    "changelog": "node ./scripts/generate-release-notes.mjs --from ${latestVersion} --to HEAD"
  },
  "npm": {
    "publish": true
  },
  "github": {
    "release": true,
    "releaseName": "Release ${version}",
    "releaseNotes": "node ./scripts/generate-release-notes.mjs --from ${latestVersion} --to HEAD --version ${version}"
  },
  "hooks": {
    "before:init": "npm run lint && npm run build",
    "after:bump": "node ./scripts/update-changelog.mjs ${latestVersion} ${version}"
  }
}
